APP_NAME="CHIMERA CLOUD"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_BASE_PATH=
APP_TIMEZONE=Asia/Kuala_Lumpur
HTTPS_ENFORCE=false

DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=chimera
DB_USERNAME=chimera_app
DB_PASSWORD=replace_with_a_unique_database_password
DB_CHARSET=utf8mb4

SESSION_NAME=chimera_session
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_LIFETIME=7200
SESSION_SAVE_PATH=

DEPLOYMENT_STORAGE_MODE=PRIVATE_OUTSIDE_WEBROOT
WEBROOT_DENIAL_VERIFIED=false
DOCUMENT_STORAGE_PATH=
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_ALLOWED_EXTENSIONS=pdf,txt,csv,md

# Required in production: generate at least 32 random characters and never commit the value.
TELEMETRY_HASH_KEY=replace_with_a_long_random_value

# Controlled academic lab. Keep false outside an explicitly authorized assessment.
VULNERABILITY_LAB_ENABLED=false

# Integration tests require a dedicated disposable database name.
TEST_DB_DATABASE=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# PRODUCTION NORMAL MODE overrides:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-authorized-domain.example
# HTTPS_ENFORCE=true
# SESSION_SECURE=true
# SESSION_SAMESITE=Lax
# DEPLOYMENT_STORAGE_MODE=PRIVATE_OUTSIDE_WEBROOT
# WEBROOT_DENIAL_VERIFIED=false
# DOCUMENT_STORAGE_PATH=/absolute/private/path/chimera-documents
# TELEMETRY_HASH_KEY=<at-least-32-random-characters>
# VULNERABILITY_LAB_ENABLED=false
# DB_USERNAME=<dedicated-non-root-runtime-user>
# DB_PASSWORD=<unique-runtime-password>

# AUTHORIZED LAB MODE uses the same hardened production values above, but only
# for an explicitly authorized academic target. This exposes controlled lab routes:
# VULNERABILITY_LAB_ENABLED=true
